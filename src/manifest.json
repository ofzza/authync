{
  "manifest_version": 3,
  "name": "Authync",
  "version": "0.0.1",
  "description": "Syncs selected tabs' credentials between browsers",
  "icons": {
    "48": "res/logo-48.png",
    "128": "res/logo-128.png"
  },
  "background": {
    "service_worker": "load-background.js",
    "type": "module"
  },
  "host_permissions": ["<all_urls>"],
  "permissions": ["scripting", "webRequest", "tabs", "cookies", "contextMenus", "storage"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["load-content.js"],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "matches": ["<all_urls>"],
      "resources": ["*.js"]
    }
  ]
}
